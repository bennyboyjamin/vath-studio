# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/vath-studio

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# AI Music Generation - Suno API
SUNO_API_KEY=your_suno_api_key
SUNO_API_URL=https://api.suno.ai

# Alternative: Stability AI
STABILITY_API_KEY=your_stability_api_key
STABILITY_API_URL=https://api.stability.ai

# AWS S3 (for storing generated songs)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=vath-studio-songs
AWS_REGION=us-east-1

# Redis (for job queue)
REDIS_URL=redis://localhost:6379

# Frontend URL
FRONTEND_URL=http://localhost:3000
